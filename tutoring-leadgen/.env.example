# ─────────────────────────────────────────────────────────────
# 複製呢個 file 做 `.env`,再填返自己嘅 key。
# `.env` 已經喺 .gitignore,唔會 commit 上 git。
# ─────────────────────────────────────────────────────────────

# ── 爬文 provider:mock | apify ──
# mock  = 用內置樣本數據,唔使 key,即刻 demo 到
# apify = 真係去 Threads 爬(要 Apify token)
SCRAPER_PROVIDER=mock
APIFY_API_TOKEN=
# Apify 上隻 Threads scraper actor 嘅 id(隨你揀用邊隻)
APIFY_ACTOR=apify/threads-scraper

# ── LLM provider:mock | gemini | openrouter ──
# mock       = 用關鍵詞啟發式分類,唔使 key,即刻 demo 到
# gemini     = Google Gemini(OpenAI-compatible endpoint)
# openrouter = OpenRouter(將來轉去淨係改呢度)
LLM_PROVIDER=mock

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter(將來用)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── 搵客條件 ──
LEAD_SCORE_THRESHOLD=0.7

# ── 爬文關鍵詞(逗號分隔)──
SEARCH_KEYWORDS=補習,搵補習,補數學,補英文,DSE補習,補習老師
