# ─────────────────────────────────────────────────────────────
# 複製做 .env(本機用)。Cloud Run 上呢啲改為 service 環境變數。
# .env 已 gitignore,唔會 commit。
# ─────────────────────────────────────────────────────────────

# ── 資料庫 ──
# 本機:留空 = 用 SQLite(leadgen.db)
# 上雲:填 Supabase / Cloud SQL 嘅 Postgres 連線字串,例如:
# DATABASE_URL=postgresql+psycopg2://postgres:你的密碼@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./leadgen.db

# ── 安全(部署前必改）──
# 產生方法:python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me
COOKIE_SECURE=false          # Cloud Run(HTTPS)設 true

# ── 第一個管理員(seed 時建立)──
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-strong-password

# ── 觸發 pipeline 嘅密鑰(Cloud Scheduler 用;留空則只有 admin 可觸發)──
PIPELINE_TOKEN=

# ── 爬文:mock | apify ──
SCRAPER_PROVIDER=mock
APIFY_API_TOKEN=
APIFY_ACTOR=apify/threads-scraper
RESULTS_LIMIT=100
SEARCH_KEYWORDS=補習,搵補習,補數學,補英文,DSE補習,補習老師

# ── LLM:mock | gemini | openrouter ──
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── 搵客門檻 ──
LEAD_SCORE_THRESHOLD=0.7
